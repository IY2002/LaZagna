# Yosys synthesis script for ${TOP_MODULE}

#########################
# Parse input files
#########################
# Read verilog files.
# -nooverwrite: VTR benchmark files carry VTR's hard-primitive simulation models
# (single_port_ram / dual_port_ram / mult ...) pasted after designs that define modules of
# the same name; the design's own (first) definition must win, not abort the read.
read_verilog -nooverwrite ${READ_VERILOG_OPTIONS} ${VERILOG_FILES}
# Read technology library
read_verilog -lib -specify ${YOSYS_BRAM_CELL_SIM}
# Those pasted models are marked (* keep_hierarchy *), which stops flatten and leaves
# .subckt single_port_ram/dual_port_ram in the BLIF, cells this architecture has no model
# for. Here they are ordinary behavioral memories that memory_bram maps to spram.
setattr -mod -unset keep_hierarchy

#########################
# Prepare for synthesis
#########################
# Identify top module from hierarchy
# Explicit top: with -auto-top, unused pasted primitives compete for top and Yosys picked
# dual_port_ram as the top of diffeq1/diffeq2/sha, synthesizing an empty design.
hierarchy -check -top ${TOP_MODULE}
# - Convert process blocks to AST
proc
# Flatten all the gates/primitives
flatten
# Single-write-port memories. The spram has one port, so a memory written from two ports
# (true dual-port) would fall back to flip-flops + LUTs. Study assumption: at most one write
# per cycle, so the write ports are merged into one (address/data/enable taken from the
# port that writes). Done here, before memory_collect, while read ports carry no per-write-
# port masks. See merge_write_ports.py.
write_rtlil merge_wp_in.il
exec -expect-return 0 -- python3 ${YOSYS_MERGE_WRITE_PORTS} merge_wp_in.il merge_wp_out.il
design -reset
read_rtlil merge_wp_out.il
# Identify tri-state buffers from 'z' signal in AST
# with follow-up optimizations to clean up AST
tribuf -logic
opt_expr
opt_clean
# demote inout ports to input or output port
# with follow-up optimizations to clean up AST
deminout
opt -nodffe -nosdff

opt_expr
opt_clean
check
opt -nodffe -nosdff
wreduce -keepdc
peepopt
pmuxtree
opt_clean

########################
# Map multipliers
# Inspired from synth_xilinx.cc
#########################
# Avoid merging any registers into DSP, reserve memory port registers first
# Let memory_dff see read-port enables. RAMs written as "if (we) write else read" give
# the read register an enable; under -nodffe it stays a feedback mux that memory_dff does
# not recognize, the read port stays asynchronous and the memory cannot become a BRAM.
# Enable FFs elsewhere are converted back later by dfflegalize, so the netlist is unchanged.
opt_dff -nosdff
memory_dff
wreduce t:$mul

techmap -map +/mul2dsp.v -map ${YOSYS_DSP_MAP} -D DSP_A_MAXWIDTH=27 -D DSP_B_MAXWIDTH=27 -D DSP_A_MINWIDTH=18 -D DSP_B_MINWIDTH=18 -D DSP_NAME=mult_27x27

chtype -map $__soft_mul $mul # Extract arithmetic functions
wreduce t:$mul

techmap -map +/mul2dsp.v -map ${YOSYS_DSP_MAP} -D DSP_A_MAXWIDTH=18 -D DSP_B_MAXWIDTH=19 -D DSP_A_MINWIDTH=2 -D DSP_B_MINWIDTH=2 -D DSP_NAME=mult_18x19

select a:mul2dsp
setattr -unset mul2dsp
opt_expr -fine
wreduce
select -clear
chtype -set $mul t:$__soft_mul# Extract arithmetic functions

#########################
# Run coarse synthesis
#########################
techmap
alumacc
share
opt -nodffe -nosdff
fsm
# Run a quick follow-up optimization to sweep out unused nets/signals
opt -fast -nodffe -nosdff
# Optimize any memory cells by merging share-able ports and collecting all the ports belonging to memorcy cells  
memory -nomap
opt_clean

memory_bram -rules ${YOSYS_BRAM_TXT}
techmap -map ${YOSYS_BRAM_MAP}
stat
opt -fast -mux_undef -undriven -fine -nodffe -nosdff
memory_map
opt -undriven -fine -nodffe -nosdff



#########################
# Map flip-flops
#########################
# Async-reset FFs become plain FFs + logic first (the CLB FF has no async reset), then legalize.
# Order matters: dfflegalize aborts on any async-reset FF still present.
techmap -map +/adff2dff.v
dfflegalize -cell $_DFF_P_ 0
opt_expr -mux_undef
simplemap
opt_expr
opt_merge
opt_dff -nodffe -nosdff
opt_clean
opt -nodffe -nosdff
stat
#########################
# Map LUTs
#########################
abc -lut 6

#########################
# Check and show statisitics
#########################
hierarchy -check
stat

#########################
# Output netlists
#########################
opt_clean -purge

write_blif -param ${OUTPUT_BLIF}
